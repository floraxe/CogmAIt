# =============================================================================
# CogmAIt 后端环境变量模板
# 使用方法：cp .env.example .env  然后填写真实值
# 注意：.env 文件已被 .gitignore 排除，请勿手动添加到 git
# =============================================================================

# ── 基础 API 配置 ──────────────────────────────────────────────────────────────
API_V1_STR=/api
PROJECT_NAME=CogmAIt

# ── 安全 ──────────────────────────────────────────────────────────────────────
# 建议使用随机字符串：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-replace-this

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── 数据库（MySQL）────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=cogmait

# 也可以直接指定完整 URI（优先级高于上面的分项配置）
# DATABASE_URI=mysql+pymysql://root:your-password@localhost:3306/cogmait

# ── MinIO 对象存储 ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ── Neo4j 图数据库（可选，不配置则关闭图谱检索）────────────────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-neo4j-password
# NEO4J_DATABASE=neo4j

# ── AI 模型提供商（至少配置一个用于对话）────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...

# ── 联网搜索（可选，智能体开启联网搜索时需要）────────────────────────────────────
# TAVILY_API_KEY=tvly-...

# ── 向量数据库（可选）────────────────────────────────────────────────────────────
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=us-east-1

# ── PDF OCR（可选）────────────────────────────────────────────────────────────
# OCR_SPACE_API_KEY=
